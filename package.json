{
  "private": true,
  "dependencies": {
    "highlight.js": "^10.7.2",
    "react-loader-spinner": "^5.3.4"
  },
  "scripts": {
    "test:contracts": "cd contracts && forge test",
    "compile:contracts": "cd contracts && forge build",
    "deploy:contracts": "pnpm compile:contracts && node client/scripts/deploy_contracts.mjs",
    "upgrade:proxy": "pnpm compile:contracts && node client/scripts/upgrade_proxy.mjs",
    "supersede:level": "pnpm compile:contracts && node client/scripts/supersede_level.mjs",
    "network": "cd contracts && anvil --block-time 1 --auto-impersonate",
    "build:ethernaut": "pnpm compile:contracts && pnpm --dir client build",
    "build:netlify": "CI=false pnpm --dir client build",
    "start:ethernaut": "pnpm --dir client start",
    "leaderboard:oldCrawler": "node client/leaderboard/scripts/crawlers/crawlHistoricalData/index.cjs",
    "leaderboard:newCrawler": "node client/leaderboard/scripts/crawlers/crawlNewData/index.cjs",
    "leaderboard:triggerNextCrawl": "node client/leaderboard/scripts/actuate/index.cjs"
  },
  "packageManager": "pnpm@12.23.0"
}
